[Unit]
Description=Smart Campus FastAPI Service
After=network.target

[Service]
User=azureuser
Group=azureuser
WorkingDirectory=/opt/smartcampus
EnvironmentFile=/opt/smartcampus/.env
ExecStart=/opt/smartcampus/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target